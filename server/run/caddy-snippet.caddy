# Quota Run 的 Caddy 配置（Caddy v2）。Scripts/deploy_run.sh 取 BEGIN/END 标记之间的内容，
# 每次部署整份覆盖 /etc/caddy/sites/quota.run.caddy；quota.bar 只做产品发布，不含任何 Quota Run 配置。
# 手工添加时照抄标记之间的内容即可。

# ---- BEGIN quota.run ----
# Quota Run：排行榜、个人主页、登录与账号页和 API。页面在 /var/www/quota.run（Scripts/deploy_site.sh 从 web-run/ 同步），
# API 由 quotabar-run.service 在本机 8788 接收。
quota.run {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@static path *.png *.jpg *.webp *.svg *.ico *.ttf *.woff2 *.css *.js
	header @static Cache-Control "public, max-age=86400"

	# 用 handle 而不是 handle_path：签名覆盖完整路径 /api/v1/…，前缀不能剥掉。
	# 服务端自己按 1 MB 回 JSON 的 413；这里的 2 MB 只是兜底。
	# /api/v1/live 是 Server-Sent Events：Caddy 见到 text/event-stream 会立即转发每一块，不用额外设置。
	# 服务端按 X-Forwarded-For 的最后一项限流。经 Cloudflare 进来的请求，直连方是 Cloudflare 的边缘节点，
	# 这时改用它给的 CF-Connecting-IP；其余请求用直连地址——不在 Cloudflare 网段里的人自己带这个头不算数。
	# 网段来自 https://www.cloudflare.com/ips-v4/ 与 /ips-v6/。
	@viaCloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy @viaCloudflare 127.0.0.1:8788 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
		reverse_proxy 127.0.0.1:8788 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	handle {
		root * /var/www/quota.run
		# 公开项目页：/@username/slug → /project.html，/zh/@username/slug → /zh/project.html（页面自己带 <base>）。
		@project path_regexp project ^/@[A-Za-z0-9][A-Za-z0-9_-]+/[a-z0-9-]+/?$
		rewrite @project /project.html
		@projectZh path_regexp projectZh ^/zh/@[A-Za-z0-9][A-Za-z0-9_-]+/[a-z0-9-]+/?$
		rewrite @projectZh /zh/project.html
		# 公开个人页：/@username → /u.html，/zh/@username → /zh/u.html。
		# 内部改写，地址栏不变，页面从 location.pathname 取用户名；用户名不存在由页面显示 404 状态。
		@profile path_regexp profile ^/@[A-Za-z0-9][A-Za-z0-9_-]+/?$
		rewrite @profile /u.html
		@profileZh path_regexp profileZh ^/zh/@[A-Za-z0-9][A-Za-z0-9_-]+/?$
		rewrite @profileZh /zh/u.html
		# 登录、账号、连接 Mac：/login → /login.html，/zh/account → /zh/account.html，以此类推。
		# 查询串（next、code）原样带着。try_files 本身也是一次 rewrite，和上面两条互斥：
		# /@username 不对应任何文件，只会走个人页那条；已有的文件和目录（/、/zh/、*.css）原样命中。
		try_files {path} {path}.html
		file_server
	}
}

www.quota.run {
	redir https://quota.run{uri} permanent
}
# ---- END quota.run ----
