# Quota Run 的 Caddy 配置（Caddy v2）。Scripts/deploy_run.sh 按下面的 BEGIN/END 标记取用：
#   第一段放进 /etc/caddy/sites/quota.bar.caddy 的 `quota.bar { … }` 站点块，前后带
#   「# >>> quota-run」「# <<< quota-run」两行，重跑时整段替换；
#   第二段是 quota.run 的完整站点，每次部署整份覆盖 /etc/caddy/sites/quota.run.caddy。
# 手工添加时照抄两段标记之间的内容即可。

# ---- BEGIN quota.bar ----
	# quota.bar 只做产品发布。Quota Run 早先挂在这里的排行榜和个人主页已经搬到 quota.run，
	# 旧地址永久跳过去；/api/run/ 不再反代。
	@quotaRunProfile path_regexp quotaRunProfile ^/(zh/)?@([A-Za-z0-9][A-Za-z0-9_-]+)/?$
	redir @quotaRunProfile https://quota.run/{re.quotaRunProfile.1}@{re.quotaRunProfile.2} 301
	@quotaRunBoard path /leaderboard /leaderboard/ /leaderboard.html
	redir @quotaRunBoard https://quota.run/ 301
	@quotaRunBoardZh path /zh/leaderboard /zh/leaderboard/ /zh/leaderboard.html
	redir @quotaRunBoardZh https://quota.run/zh/ 301
# ---- END quota.bar ----

# ---- BEGIN quota.run ----
# Quota Run：排行榜、个人主页、登录与账号页和 API。页面在 /var/www/quota.run（Scripts/deploy_site.sh 从 web-run/ 同步），
# API 由 quotabar-run.service 在本机 8788 接收。
quota.run {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@static path *.png *.jpg *.webp *.svg *.ico *.ttf *.woff2 *.css *.js
	header @static Cache-Control "public, max-age=86400"

	# 用 handle 而不是 handle_path：签名覆盖完整路径 /api/v1/…，前缀不能剥掉。
	# 服务端自己按 1 MB 回 JSON 的 413；这里的 2 MB 只是兜底。
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8788
	}

	handle {
		root * /var/www/quota.run
		# 早先的排行榜地址。
		redir /leaderboard / 301
		redir /zh/leaderboard /zh/ 301
		# 公开个人页：/@username → /u.html，/zh/@username → /zh/u.html。
		# 内部改写，地址栏不变，页面从 location.pathname 取用户名；用户名不存在由页面显示 404 状态。
		@profile path_regexp profile ^/@[A-Za-z0-9][A-Za-z0-9_-]+/?$
		rewrite @profile /u.html
		@profileZh path_regexp profileZh ^/zh/@[A-Za-z0-9][A-Za-z0-9_-]+/?$
		rewrite @profileZh /zh/u.html
		# 登录、账号、连接 Mac：/login → /login.html，/zh/account → /zh/account.html，以此类推。
		# 查询串（next、code）原样带着。try_files 本身也是一次 rewrite，和上面两条互斥：
		# /@username 不对应任何文件，只会走个人页那条；已有的文件和目录（/、/zh/、*.css）原样命中。
		try_files {path} {path}.html
		file_server
	}
}

www.quota.run {
	redir https://quota.run{uri} permanent
}
# ---- END quota.run ----
