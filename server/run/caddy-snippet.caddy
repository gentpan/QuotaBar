# Quota Run 的 Caddy 配置片段（Caddy v2）。Scripts/deploy_run.sh 按下面的 BEGIN/END 标记取用：
#   第一段插进 /etc/caddy/sites/quota.bar.caddy 的 `quota.bar { … }` 站点块末尾；
#   第二段是独立站点块，写成 /etc/caddy/sites/quota.run.caddy（quota.run 解析到本机后才装）。
# 手工添加时照抄两段标记之间的内容即可。

# ---- BEGIN quota.bar ----
	# Quota Run API：quotabar-run.service 在本机 8788 接收。
	# 用 handle 而不是 handle_path：签名覆盖完整路径 /api/run/v1/…，前缀不能剥掉。
	# 服务端自己按 1 MB 回 JSON 的 413；这里的 2 MB 只是兜底。
	handle /api/run/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8788
	}
	# 公开个人页：/@username → /u.html，/zh/@username → /zh/u.html。
	# 内部改写，地址栏不变，页面从 location.pathname 取用户名；用户名不存在由页面显示 404 状态。
	@quotaRunProfile path_regexp quotaRunProfile ^/@[A-Za-z0-9][A-Za-z0-9_-]+/?$
	rewrite @quotaRunProfile /u.html
	@quotaRunProfileZh path_regexp quotaRunProfileZh ^/zh/@[A-Za-z0-9][A-Za-z0-9_-]+/?$
	rewrite @quotaRunProfileZh /zh/u.html
	# 排行榜的干净地址：/leaderboard、/zh/leaderboard（canonical 用的就是这两个）。
	@quotaRunBoard path /leaderboard /leaderboard/
	rewrite @quotaRunBoard /leaderboard.html
	@quotaRunBoardZh path /zh/leaderboard /zh/leaderboard/
	rewrite @quotaRunBoardZh /zh/leaderboard.html
# ---- END quota.bar ----

# ---- BEGIN quota.run ----
# quota.run 只做跳转：个人页地址原样映射到 quota.bar，其余一律落到排行榜。
# 先用 302，确认稳定后再考虑换成 301（浏览器会永久缓存 301）。
quota.run, www.quota.run {
	@quotaRunUser path_regexp quotaRunUser ^/(zh/)?@([A-Za-z0-9][A-Za-z0-9_-]+)/?$
	handle @quotaRunUser {
		redir https://quota.bar/{re.quotaRunUser.1}@{re.quotaRunUser.2} 302
	}
	@quotaRunZh path_regexp quotaRunZh ^/zh(/.*)?$
	handle @quotaRunZh {
		redir https://quota.bar/zh/leaderboard 302
	}
	handle {
		redir https://quota.bar/leaderboard 302
	}
}
# ---- END quota.run ----
